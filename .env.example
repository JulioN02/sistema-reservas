# =============================================================================
# sistema-reservas — variables de entorno (ejemplo)
#
# Copia este archivo a `.env` para desarrollo local:  cp .env.example .env
# Docker Compose lee `.env` automáticamente para interpolar `${VAR}`.
# NUNCA commitear un `.env` real (solo `.env.example`).
# =============================================================================

# -----------------------------------------------------------------------------
# API (apps/api) — fuente de verdad de configuración (diseño §10, RNF-03).
# Validado con zod en el arranque (fail-fast): apps/api/src/config/env.ts.
# -----------------------------------------------------------------------------

# Cadena de conexión PostgreSQL. En compose el host es el servicio `db`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sistema_reservas

# Puerto HTTP del API.
PORT=3000

# Nivel de log de pino: fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info

# Slug del tenant público (único tenant activo en v1). Minúsculas/dígitos/guiones.
DEFAULT_TENANT_SLUG=demo

# Origen EXACTO de la SPA (nunca `*`). Debe coincidir con la URL del web.
CORS_ORIGIN=http://localhost:5173

# Cookie de sesión `Secure` (true SOLO con HTTPS en producción).
COOKIE_SECURE=false

# TTL de la sesión del operador, en días (1–30).
SESSION_TTL_DAYS=7

# Lead del recordatorio, en minutos (default 24 h). Si el turno cae dentro del
# lead, el envío es inmediato.
REMINDER_LEAD_MIN=1440

# Canal de notificaciones: `log` (dev/demo, sin proveedor) | `email` (Resend).
NOTIFICATION_CHANNEL=log

# Resend (solo si NOTIFICATION_CHANNEL=email). Sin key, el sistema usa LogChannel.
RESEND_API_KEY=
RESEND_FROM=

# -----------------------------------------------------------------------------
# Credenciales del operador demo (las usa el seed idempotente `db:seed`).
# SOLO desarrollo. En producción se configuran como secretos del entorno.
# -----------------------------------------------------------------------------
OPERADOR_EMAIL=operador@demo.local
OPERADOR_PASSWORD=demo-password-123

# -----------------------------------------------------------------------------
# Web (apps/web) — Vite. VITE_API_URL es BUILD-TIME (no .env de runtime).
#  - Se inyecta en el build del contenedor vía --build-arg (ver apps/web/Dockerfile).
#  - Default del contenedor: `/api/v1` (same-origin, proxy Nginx en compose local).
#  - En Railway: URL pública del API, p. ej. https://api.tudominio.com/api/v1
#  - NO definir vacío: rompería la base del apiClient. Dejar sin definir aquí.
# -----------------------------------------------------------------------------
# VITE_API_URL=https://api.tudominio.com/api/v1

# -----------------------------------------------------------------------------
# Docker Compose (puertos del host). Los defaults están en docker-compose.yml.
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433
API_PORT=3000
WEB_PORT=8080

# -----------------------------------------------------------------------------
# E2E (Playwright, T-24). URL base del stack a probar.
# -----------------------------------------------------------------------------
E2E_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Tests de integración (apps/api). Sin esta variable los tests de BD se skipean.
# Default local: servicio db-test de docker compose (ver POSTGRES_TEST_PORT).
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/sistema_reservas_test
