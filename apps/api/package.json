{
  "name": "@sistema-reservas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Reservas — API (Fastify + Drizzle + PostgreSQL)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@sistema-reservas/contracts": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0"
  }
}