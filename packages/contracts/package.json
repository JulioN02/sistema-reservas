{
  "name": "@sistema-reservas/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Reservas — OpenAPI 3.1 contract, generated types and shared enums",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "generate:types": "openapi-typescript openapi.yaml -o src/generated/api.ts",
    "lint:contract": "redocly lint openapi.yaml --config redocly.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0",
    "openapi-typescript": "^7.6.0",
    "yaml": "^2.7.0"
  }
}